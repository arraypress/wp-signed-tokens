{
  "name": "arraypress/wp-signed-tokens",
  "description": "HMAC-signed, expiring, namespaced tokens for URLs. Download links, magic sign-in, password resets and unsubscribe links with no database row.",
  "homepage": "https://github.com/arraypress/wp-signed-tokens/",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "wordpress",
    "token",
    "hmac",
    "signed-url",
    "download-link",
    "magic-link",
    "passwordless",
    "expiring"
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\SignedTokens\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\SignedTokens\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  },
  "support": {
    "issues": "https://github.com/arraypress/wp-signed-tokens/issues",
    "source": "https://github.com/arraypress/wp-signed-tokens"
  }
}
